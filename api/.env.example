# Local development values only. Replace them before using a shared environment.
EPR_DB_PORT=5432
EPR_DB_NAME=epr

EPR_DB_OWNER_USERNAME=epr_owner
EPR_DB_OWNER_PASSWORD=epr-owner-local-only

EPR_DB_MIGRATION_USERNAME=epr_migrator
EPR_DB_MIGRATION_PASSWORD=epr-migrator-local-only

EPR_DB_USERNAME=epr_app
EPR_DB_PASSWORD=epr-app-local-only
EPR_DB_URL=jdbc:postgresql://localhost:5432/epr

EPR_SECURE_COOKIES=false
