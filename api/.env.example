# Local development values only. Replace them before using a shared environment.
EPR_DB_PORT=5432
EPR_DB_NAME=epr

EPR_DB_OWNER_USERNAME=epr_owner
EPR_DB_OWNER_PASSWORD=epr-owner-local-only

EPR_DB_MIGRATION_USERNAME=epr_migrator
EPR_DB_MIGRATION_PASSWORD=epr-migrator-local-only

EPR_DB_USERNAME=epr_app
EPR_DB_PASSWORD=epr-app-local-only
EPR_DB_URL=jdbc:postgresql://localhost:5432/epr

# Local tenant database provisioning. The encryption key must decode to 32 bytes.
EPR_TENANT_PROVISIONING_ENABLED=true
EPR_TENANT_ADMIN_DB_URL=jdbc:postgresql://localhost:5432/epr
EPR_TENANT_DB_URL_TEMPLATE=jdbc:postgresql://localhost:5432/{database}
EPR_TENANT_CREDENTIAL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

EPR_SECURE_COOKIES=false
EPR_PROXY_PORT=80

# Local profile only. Never use these development credentials in a shared environment.
EPR_LOCAL_SUPERADMIN_USERNAME=superadmin
EPR_LOCAL_SUPERADMIN_PASSWORD=ChangeMe123!
EPR_LOCAL_SUPERADMIN_DISPLAY_NAME=Local Superadmin
